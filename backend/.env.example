# backend/.env.example
# Copy this file to .env and fill in real values. Never commit .env.

# ============================================================
# SERVER
# ============================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============================================================
# DATABASE
# ============================================================
MONGODB_URI=

# ============================================================
# AUTH
# ============================================================
JWT_SECRET=
JWT_EXPIRE=7d

# ============================================================
# EMAIL (SMTP) — order confirmations, password reset, etc.
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# CLOUDINARY — image/file uploads
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# PAYMENTS — PayPal (active, wired into checkout)
# ============================================================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ============================================================
# PAYMENTS — Stripe (backend provider implemented and functional;
# ============================================================
# PAYMENTS — Stripe (Credit/Debit Card, and Klarna/Afterpay if
# enabled in your Stripe Dashboard's payment methods settings —
# they surface automatically in the same PaymentElement)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# SEEDING — only used by database seed scripts, if you run them
# ============================================================
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ============================================================
# REDIS — config file exists but is not currently imported/used
# anywhere in the codebase. Leave blank unless you wire it in.
# ============================================================
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
