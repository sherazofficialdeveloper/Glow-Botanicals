# frontend/.env.example
# Copy this file to .env.local and fill in real values.
# Only NEXT_PUBLIC_* variables are safe here — anything without that
# prefix would still end up bundled into client-side JS. Never put
# secret keys (Stripe secret key, PayPal secret, etc.) in this file.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Stripe publishable key — safe for the browser. Required for the
# card payment option at checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# NOTE: The following are not currently referenced anywhere in the
# frontend code, so setting them won't do anything yet:
#   NEXT_PUBLIC_PAYPAL_CLIENT_ID   (PayPal uses the backend-driven
#                                    redirect flow, not a client SDK)
#   NEXT_PUBLIC_GA_MEASUREMENT_ID  (no analytics integration present)
#   NEXT_PUBLIC_FB_PIXEL_ID        (no pixel integration present)
